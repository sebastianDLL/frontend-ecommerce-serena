---
import SiteLayout from '../layouts/SiteLayout.astro';
import '../styles/about.css';

const values = [
	{
		title: 'Origen vegetal',
		text: 'Cera de soya 100% natural, renovable y biodegradable. Sin parafinas derivadas del petróleo, para una combustión limpia y libre de toxinas.',
		icon: '<path d="M12 22c4-3 8-6.5 8-11a8 8 0 1 0-16 0c0 4.5 4 8 8 11z"></path><path d="M12 22V9"></path><path d="M12 13c-1.5-1-3-1.5-4.5-1.5"></path><path d="M12 15c1.5-1 3-1.5 4.5-1.5"></path>',
	},
	{
		title: 'Fragancia consciente',
		text: 'Esencias botánicas y aceites naturales dosificados a mano. Aromas que envuelven sin invadir, pensados para acompañar momentos de descanso y presencia.',
		icon: '<path d="M12 21c-4.5-2.5-7-5.5-7-9a7 7 0 0 1 14 0c0 3.5-2.5 6.5-7 9z"></path><path d="M12 3v4"></path><path d="M10 7c0 1 1 1.5 2 2 1-.5 2-1 2-2"></path>',
	},
	{
		title: 'Hecho a mano',
		text: 'Cada vela se vierte, etiqueta y empaca manualmente en pequeños lotes. Imperfecciones mínimas que celebran lo artesanal: ninguna vela es idéntica a otra.',
		icon: '<path d="M7 11V6a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v5"></path><path d="M4 11h16v9a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-9z"></path><path d="M9 16h6"></path>',
	},
	{
		title: 'Círculo consciente',
		text: 'Frascos de vidrio reutilizables y empaques reciclables. Queremos que la calma que traes a tu casa también cuide el mundo que habitamos.',
		icon: '<path d="M21 12a9 9 0 1 1-9-9"></path><path d="M21 3v6h-6"></path><path d="M9 12l2 2 4-4"></path>',
	},
];

const processSteps = [
	{
		number: '01',
		title: 'Selección botánica',
		text: 'Elegimos cera de soya de cultivo responsable y combinamos aceites esenciales hasta lograr perfiles aromáticos que transmiten calma, claridad o calidez.',
	},
	{
		number: '02',
		title: 'Vertido artesanal',
		text: 'Fundimos a baja temperatura y vertimos a mano en frascos de vidrio, colocando pabilos de algodón ecológico centrados a la perfección.',
	},
	{
		number: '03',
		title: 'Curado y descanso',
		text: 'Cada vela reposa en curado durante días para que la fragancia se asiente. Solo entonces se etiqueta y empaca, lista para encender tu ritual.',
	},
];
---

<SiteLayout
	title="Nosotros | SERENA"
	description="Conoce la esencia de SERENA: velas aromáticas artesanales vertidas a mano con cera de soya 100% natural, fragancias botánicas y diseño consciente."
	keywords="velas aromáticas, cera de soya, velas artesanales, SERENA, nosotros, historia"
	ogTitle="Nosotros | SERENA"
	ogDescription="Nuestra historia, valores y el proceso artesanal detrás de cada vela SERENA."
	active="nosotros"
>
	<!-- Hero Nosotros -->
	<section class="about-hero">
		<div class="about-hero-copy">
			<span class="eyebrow">Nuestra esencia</span>
			<h1 class="about-hero-title">
				Una pausa encendida <em>a mano.</em>
			</h1>
			<p class="about-hero-text">
				SERENA nace de una convicción simple: la calma no se compra, se cultiva en los pequeños rituales del día. Cada
				vela que vertemos es una invitación a encender esa luz interior, a respirar profundo y a volver a ti.
			</p>
			<div class="about-hero-stats">
				<div class="about-stat">
					<strong>100%</strong>
					<span>Cera de soya vegetal</span>
				</div>
				<div class="about-stat">
					<strong>A mano</strong>
					<span>Vertido en pequeños lotes</span>
				</div>
				<div class="about-stat">
					<strong>Botánico</strong>
					<span>Fragancias naturales</span>
				</div>
			</div>
		</div>
		<div class="about-hero-visual">
			<img
				src="https://images.unsplash.com/photo-1602523961358-f9f03dd557db?auto=format&fit=crop&w=900&q=80"
				alt="Vela artesanal SERENA encendida en vaso ámbar"
			/>
			<div class="about-float-card">
				<p class="card-tag">Hecho en Bolivia</p>
				<h4>Oficio local, calma universal</h4>
				<p class="card-sub">Producción artesanal con materiales de comercio justo.</p>
			</div>
		</div>
	</section>

	<!-- Nuestra Historia -->
	<section class="about-story">
		<div class="about-story-inner">
			<div class="about-story-media">
				<img
					src="https://images.unsplash.com/photo-1603006905003-be475563bc59?auto=format&fit=crop&w=900&q=80"
					alt="Proceso artesanal de elaboración de velas SERENA"
				/>
			</div>
			<div class="about-story-copy">
				<span class="eyebrow">Nuestra historia</span>
				<h2>
					De un ritual personal a una <em>misión compartida.</em>
				</h2>
				<p>
					SERENA comenzó en una cocina pequeña, con una olla de cera de soya, aceites esenciales seleccionados a mano y
					la certeza de que encender una vela podía cambiar el ánimo de toda una casa. Lo que era un ritual personal
					para cerrar el día, pronto se convirtió en regalos para amigos, pedidos de vecinos y una comunidad que pedía
					más.
				</p>
				<p>
					Hoy seguimos vertiendo cada vela a mano, en pequeños lotes, con la misma dedicación del primer día. Creemos
					que los objetos que habitamos deberían cuidarnos: por eso trabajamos solo con cera de soya 100% vegetal,
					pabilos de algodón ecológico y fragancias botánicas que respetan tu espacio y el planeta.
				</p>
				<p>
					Más que una tienda de velas, SERENA es una invitación a construir santuario propio: ese rincón de tu hogar
					donde la luz es cálida, el aroma abraza y el tiempo se suaviza.
				</p>
			</div>
		</div>
	</section>

	<!-- Nuestros Valores -->
	<section class="about-values">
		<div class="about-values-inner">
			<div class="about-values-head">
				<span class="eyebrow">Lo que nos mueve</span>
				<h2>
					Valores que <em>iluminan</em> cada lote
				</h2>
			</div>
			<div class="values-grid">
				{values.map((value) => (
					<article class="value-card">
						<div class="value-icon">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" set:html={value.icon} />
						</div>
						<h3>{value.title}</h3>
						<p>{value.text}</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<!-- Nuestro Proceso -->
	<section class="about-process dark-surface">
		<div class="about-process-inner">
			<div class="about-process-head">
				<span class="eyebrow">Del taller a tu hogar</span>
				<h2>
					El proceso detrás de <em>cada llama</em>
				</h2>
			</div>
			<ol class="process-steps">
				{processSteps.map((step) => (
					<li class="process-step">
						<span class="step-number">{step.number}</span>
						<h3>{step.title}</h3>
						<p>{step.text}</p>
					</li>
				))}
			</ol>
		</div>
	</section>

	<!-- Cita de Marca / Statement -->
	<section class="statement">
		<div class="statement-inner">
			<span class="eyebrow">Nuestra Filosofía</span>
			<h2>
				"No buscamos llenar espacios, sino encender <em>momentos de presencia</em> que te devuelvan a ti."
			</h2>
			<p class="statement-desc">
				Cada vela SERENA se elabora pensando en el balance entre luz, aroma y serenidad. Diseñadas para que al final del
				día encuentres un momento de intimidad contigo mismo.
			</p>
		</div>
	</section>

	<!-- Llamado a la acción -->
	<section class="about-cta">
		<div class="about-cta-inner">
			<h2>
				¿Lista para encender <em>tu ritual?</em>
			</h2>
			<p>
				Descubre la colección completa de velas aromáticas artesanales y encuentra la fragancia que acompañe tu momento
				de calma.
			</p>
			<div class="about-cta-actions">
				<a href="/#coleccion" class="primary-button">
					<span>Explorar colección</span>
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
						<path d="M12 5v14"></path>
						<path d="M5 12l7 7 7-7"></path>
					</svg>
				</a>
				<a href="/#contacto" class="secondary-button">
					<span>Hablar con nosotros</span>
				</a>
			</div>
		</div>
	</section>
</SiteLayout>
