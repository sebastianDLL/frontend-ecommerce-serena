---
import SiteLayout from '../layouts/SiteLayout.astro';
import Hero from '../components/home/Hero.astro';
import Pillars from '../components/home/Pillars.astro';
import Statement from '../components/home/Statement.astro';
import Catalog from '../components/catalog/Catalog.vue';
---

<SiteLayout
	title="SERENA | Velas para volver a ti"
	description="SERENA | Velas aromáticas artesanales elaboradas con cera de soya 100% natural, fragancias botánicas y diseño consciente para volver a ti."
	keywords="velas aromáticas, cera de soya, velas artesanales, aromaterapia, decoración hogar, SERENA"
	ogDescription="Momentos de calma, presencia y luz. Descubre nuestra colección de velas aromáticas artesanales."
	active="home"
	withCart
>
	<Hero />
	<Pillars />
	<Catalog client:visible />
	<Statement />
</SiteLayout>
