---
import Storefront from '../components/Storefront.vue';
import '../styles/global.css';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Source+Sans+3:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400;1,8..60,600&display=swap"
			rel="stylesheet"
		/>
		<meta name="description" content="SERENA | Velas aromáticas artesanales elaboradas con cera de soya 100% natural, fragancias botánicas y diseño consciente para volver a ti." />
		<meta name="keywords" content="velas aromáticas, cera de soya, velas artesanales, aromaterapia, decoración hogar, SERENA" />
		<meta property="og:title" content="SERENA | Velas para volver a ti" />
		<meta property="og:description" content="Momentos de calma, presencia y luz. Descubre nuestra colección de velas aromáticas artesanales." />
		<meta property="og:type" content="website" />
		<meta property="og:image" content="/Original_1-8.png" />
		<meta name="theme-color" content="#2b595e" />
		<title>SERENA | Velas para volver a ti</title>
	</head>
	<body>
		<Storefront client:load />
	</body>
</html>
