---
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	keywords?: string;
	ogTitle?: string;
	ogDescription?: string;
	ogImage?: string;
	robots?: string;
}

const {
	title,
	description,
	keywords,
	ogTitle = title,
	ogDescription = description,
	ogImage = '/Original_1-8.png',
	robots,
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Source+Sans+3:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400;1,8..60,600&display=swap"
			rel="stylesheet"
		/>
		<meta name="description" content={description} />
		{keywords && <meta name="keywords" content={keywords} />}
		{robots && <meta name="robots" content={robots} />}
		<meta property="og:site_name" content="SERENA" />
		<meta property="og:locale" content="es_BO" />
		<meta property="og:title" content={ogTitle} />
		<meta property="og:description" content={ogDescription} />
		<meta property="og:type" content="website" />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:alt" content="Velas aromáticas artesanales SERENA" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={ogTitle} />
		<meta name="twitter:description" content={ogDescription} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="theme-color" content="#2b595e" />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>
