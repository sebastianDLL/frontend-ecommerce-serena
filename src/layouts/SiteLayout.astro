---
import Layout from './Layout.astro';
import AnnouncementBar from '../components/ui/AnnouncementBar.astro';
import SiteHeader from '../components/ui/SiteHeader.astro';
import SiteFooter from '../components/ui/SiteFooter.astro';

interface Props {
	title: string;
	description: string;
	keywords?: string;
	ogTitle?: string;
	ogDescription?: string;
	ogImage?: string;
	robots?: string;
	active?: 'home' | 'nosotros' | 'privacidad' | 'condiciones';
	withCart?: boolean;
}

const { title, description, keywords, ogTitle, ogDescription, ogImage, robots, active, withCart = false } = Astro.props;
---

<Layout
	title={title}
	description={description}
	keywords={keywords}
	ogTitle={ogTitle}
	ogDescription={ogDescription}
	ogImage={ogImage}
	robots={robots}
>
	<AnnouncementBar />
	<SiteHeader active={active} withCart={withCart} />
	<main>
		<slot />
	</main>
	<SiteFooter />
</Layout>
