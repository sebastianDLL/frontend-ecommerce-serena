---
import Layout from './Layout.astro';
import AdminUserMenu from '../components/admin/AdminUserMenu.vue';
import '../styles/admin.css';
import { BRAND_NAME } from '../lib/constants';

interface Props {
	title: string;
	description?: string;
	section?: 'dashboard' | 'productos' | 'categorias' | 'ventas';
}

const { title, description = 'Panel de administración de SERENA', section } = Astro.props;

const nav = [
	{
		key: 'dashboard',
		href: '/admin',
		label: 'Resumen',
		icon: '<path d="M3 12h7V3H3z"></path><path d="M14 21h7V12h-7z"></path><path d="M14 3v6h7V3z"></path><path d="M3 21h7v-6H3z"></path>',
	},
	{
		key: 'productos',
		href: '/admin/productos',
		label: 'Productos',
		icon: '<path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><path d="M3.27 6.96 12 12.01l8.73-5.05"></path><path d="M12 22.08V12"></path>',
	},
	{
		key: 'categorias',
		href: '/admin/categorias',
		label: 'Categorías',
		icon: '<path d="M20.59 13.41 13.42 20.58a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><circle cx="7" cy="7" r="1.5"></circle>',
	},
	{
		key: 'ventas',
		href: '/admin/ventas',
		label: 'Ventas',
		icon: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><path d="M14 2v6h6"></path><path d="M9 15h6"></path><path d="M9 11h2"></path>',
	},
];
---

<Layout title={`${title} | Panel ${BRAND_NAME}`} description={description} robots="noindex, nofollow">
	<div class="admin-shell">
		<aside class="admin-sidebar">
			<div class="admin-brand">
				<img src="/Original_1-8.png" alt="SERENA" />
				<div class="admin-brand-text">
					<strong>{BRAND_NAME}</strong>
					<span>Panel</span>
				</div>
			</div>

			<nav aria-label="Secciones del panel">
				<ul class="admin-nav">
					{nav.map((item) => (
						<li>
							<a href={item.href} class:list={['admin-nav-link', { active: section === item.key }]}>
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" set:html={item.icon} />
								<span>{item.label}</span>
							</a>
						</li>
					))}
				</ul>
			</nav>

			<div class="admin-sidebar-footer">
				<a href="/" target="_blank" rel="noopener noreferrer">
					<svg
						width="15"
						height="15"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.8"
						aria-hidden="true"
					>
						<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
						<path d="M15 3h6v6"></path>
						<path d="M10 14 21 3"></path>
					</svg>
					<span>Ver tienda</span>
				</a>
			</div>
		</aside>

		<div class="admin-main">
			<header class="admin-topbar">
				<div>
					<span class="admin-breadcrumb">{BRAND_NAME} · Panel</span>
					<h1>{title}</h1>
				</div>
				<div class="admin-topbar-actions">
					<AdminUserMenu client:load />
				</div>
			</header>

			<div class="admin-content">
				<slot />
			</div>
		</div>
	</div>
</Layout>
