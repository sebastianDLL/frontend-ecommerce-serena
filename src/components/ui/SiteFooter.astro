---
import { BRAND_NAME, CONTACT } from '../../lib/constants';

const year = new Date().getFullYear();

const explore = [
	{ href: '/#coleccion', label: 'Colección completa' },
	{ href: '/#beneficios', label: 'Por qué SERENA' },
	{ href: '/nosotros', label: 'Nuestra esencia' },
	{ href: '/privacidad', label: 'Política de privacidad' },
	{ href: '/condiciones', label: 'Condiciones del servicio' },
];
---

<footer id="contacto" class="site-footer">
	<div class="footer-inner">
		<div class="footer-brand">
			<img src="/Original_1-8.png" alt="SERENA" />
			<p>
				Velas aromáticas artesanales elaboradas con cera de soya botánica y fragancias conscientes para transformar tu
				bienestar cotidiano.
			</p>
		</div>

		<nav class="footer-col" aria-label="Enlaces del sitio">
			<h4>Explorar</h4>
			<ul>
				{explore.map((link) => (
					<li>
						<a href={link.href}>{link.label}</a>
					</li>
				))}
			</ul>
		</nav>

		<div class="footer-col">
			<h4>Atención al cliente</h4>
			<ul>
				<li>
					<a href={CONTACT.whatsappUrl} target="_blank" rel="noopener noreferrer">
						WhatsApp directo
					</a>
				</li>
				<li>
					<a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
				</li>
				<li>
					<span>{CONTACT.schedule}</span>
				</li>
				<li>
					<span>{CONTACT.shipping}</span>
				</li>
			</ul>
		</div>
	</div>

	<div class="footer-bottom">
		<p>
			© {year} {BRAND_NAME}. Todos los derechos reservados.
		</p>
		<div class="footer-meta">
			<span class="footer-badge-tag">Cera de soya 100% vegetal</span>
			<span class="footer-badge-tag">Hecho en Bolivia</span>
			<span class="footer-badge-tag">Empaque reciclable</span>
		</div>
		<a class="footer-top-link" href="#contenido">
			Volver arriba
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
				<path d="M12 19V5"></path>
				<path d="M5 12l7-7 7 7"></path>
			</svg>
		</a>
	</div>
</footer>
