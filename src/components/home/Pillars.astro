---
const pillars = [
	{
		title: 'Cera 100% de soya',
		text: 'Combustión limpia y lenta, sin derivados del petróleo ni humos negros nocivos.',
		icon: '<path d="M4 20c0-8.5 6.2-14.6 16-15.5C20 14.5 13.8 20 4 20z"></path><path d="M4 20c3.2-5.4 7.2-8.6 12.4-10.2"></path>',
	},
	{
		title: 'Esencias botánicas',
		text: 'Aceites concentrados con notas de aromaterapia que equilibran tus emociones.',
		icon: '<path d="M12 21c-4.4-2.4-7-5.4-7-8.8a7 7 0 0 1 14 0c0 3.4-2.6 6.4-7 8.8z"></path><path d="M12 3.2v5"></path>',
	},
	{
		title: 'Artesanía cuidadosa',
		text: 'Cada pieza es vertida a mano en pequeños lotes garantizando máxima calidad.',
		icon: '<path d="M12 3.5l1.9 5.1 5.1 1.9-5.1 1.9L12 17.5l-1.9-5.1L5 10.5l5.1-1.9z"></path><path d="M18.5 16.5l.7 1.8 1.8.7-1.8.7-.7 1.8-.7-1.8-1.8-.7 1.8-.7z"></path>',
	},
	{
		title: 'Envíos seguros',
		text: 'Empaque ecológico especialmente protegido para llegar perfecto a tu hogar.',
		icon: '<path d="M3.5 8.5 12 4l8.5 4.5v7L12 20l-8.5-4.5z"></path><path d="M3.5 8.5 12 13l8.5-4.5"></path><path d="M12 13v7"></path>',
	},
];
---

<section id="beneficios" class="pillars-section" aria-label="Pilares de calidad">
	<div class="pillars-grid">
		{pillars.map((pillar) => (
			<div class="pillar-item">
				<div class="pillar-icon">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" set:html={pillar.icon} />
				</div>
				<div>
					<h3>{pillar.title}</h3>
					<p>{pillar.text}</p>
				</div>
			</div>
		))}
	</div>
</section>
